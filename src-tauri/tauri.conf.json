{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OneCRT",
  "version": "0.2.1",
  "identifier": "com.sprin.shellx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OneCRT",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#222426",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDMERENUQyMDI4N0NFNDcKUldSSHpvY0MwdFVObkdPeFBObDJyamxHYmJEa3NmVS9uQURVemJXdG1qVkFmd2g0ZXd0M3ZLeWEK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/SpringHgui/onecrt/releases/latest/download/latest.json",
        "https://github.com/SpringHgui/onecrt/releases/latest/download/latest.json"
      ]
    }
  }
}
